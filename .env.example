# Names only. Real values come from the hosting platform's secret store.
# Copy to .env for local development; never commit .env.

APP_ENV=development          # development | testing | production (staging uses production)
SECRET_KEY=                  # production: 32+ random characters
DATABASE_URL=                # postgresql+psycopg://user:password@host:5432/dbname
REDIS_URL=                   # redis://host:6379/0
TRUSTED_PROXY_HOPS=0         # number of reverse proxies in front of the app (production: usually 1)

# Checkout stays closed until these business rules and provider credentials are set.
SUPPORTED_COUNTRIES=         # comma-separated ISO alpha-2 codes, e.g. US,CA
FLAT_SHIPPING_CENTS=         # one non-negative integer amount in cents (old site: 1000)
SHIPPING_BACKEND=            # flat | shippo (live USPS rates, flat rate as fallback)
SHIPPO_API_TOKEN=            # Shippo live/test API token (secret)
SHIPPO_CARRIERS=             # optional, default USPS
SHIPPING_HANDLING_CENTS=     # optional amount added to each Shippo rate
SHIP_FROM_STREET=            # ship-from address used for Shippo rates and labels
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=               # old store origin: 19143
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=
GA4_MEASUREMENT_ID=          # Google Analytics 4, e.g. G-XXXXXXXXXX (loads only after visitor consent)
LOCAL_SHIPPING_CENTS=        # optional lower rate for Philadelphia ZIP codes (old local rate: 500)
TAX_BACKEND=                 # currently supported: none (only when no tax must be collected)
ORDER_NOTIFICATION_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=      # e.g. us21
MAILCHIMP_LIST_ID=
APPLE_PAY_DOMAIN_ASSOCIATION= # absolute path to Stripe/Apple verification file

# Optional: run the test suite against real services instead of SQLite/fake Redis
TEST_DATABASE_URL=
TEST_REDIS_URL=

# One-off media import from the old WordPress site (dev machine only; read-only use)
# WORDPRESS_DB_URL=mysql://root@localhost/new_wordpress_local
# Where photos/videos live on disk (default: instance/media). Back it up with the database.
# MEDIA_ROOT=/srv/instance/media
# Set to 0 when the web server (nginx/Caddy) serves /media/ straight from MEDIA_ROOT.
# SERVE_MEDIA=1
