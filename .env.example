# Names only. Real values come from the hosting platform's secret store.
# Copy to .env for local development; never commit .env.

APP_ENV=development          # development | testing | production (staging uses production)
SECRET_KEY=                  # production: 32+ random characters
DATABASE_URL=                # postgresql+psycopg://user:password@host:5432/dbname
REDIS_URL=                   # redis://host:6379/0
TRUSTED_PROXY_HOPS=0         # number of reverse proxies in front of the app (production: usually 1)

# Optional: run the test suite against real services instead of SQLite/fake Redis
TEST_DATABASE_URL=
TEST_REDIS_URL=
