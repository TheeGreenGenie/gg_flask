# Names only. Real values come from the hosting platform's secret store.
# Copy to .env for local development; never commit .env.

APP_ENV=development          # development | testing | production (staging uses production)
SECRET_KEY=                  # production: 32+ random characters
DATABASE_URL=                # postgresql+psycopg://user:password@host:5432/dbname
REDIS_URL=                   # redis://host:6379/0
TRUSTED_PROXY_HOPS=0         # number of reverse proxies in front of the app (production: usually 1)

# Checkout stays closed until these business rules and provider credentials are set.
SUPPORTED_COUNTRIES=US,CA,MX # owner decision: United States, Canada, and Mexico
FLAT_SHIPPING_CENTS=1000     # old-site $10 fallback when the live API is unavailable
SHIPPING_BACKEND=shippo      # live API rate; configured flat/local amounts remain fallbacks
SHIPPO_API_TOKEN=            # Shippo live/test API token (secret)
SHIPPO_CARRIERS=             # optional, default USPS
SHIPPING_HANDLING_CENTS=     # optional amount added to each Shippo rate
SHIP_FROM_STREET=            # ship-from address used for Shippo rates and labels
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=               # old store origin: 19143
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=
GA4_MEASUREMENT_ID=          # Google Analytics 4, e.g. G-XXXXXXXXXX (loads only after visitor consent)
LOCAL_SHIPPING_CENTS=500     # old-site $5 Philadelphia fallback
TAX_BACKEND=                 # stripe (Stripe Tax; needs STRIPE_SECRET_KEY) | none (only when no tax must be collected)
ORDER_NOTIFICATION_EMAIL=     # default ggafrikan@gmail.com (owner, 2026-10-27): new orders, Studio approvals, daily summary
# Transactional email (password resets, order emails, Studio summary). Any provider's SMTP relay.
MAIL_BACKEND=                 # smtp in production (unset = email off); console locally
MAIL_FROM=                    # e.g. GG Afrikan Eleganz <orders@ggafrikaneleganz.com> (domain verified with the provider)
MAIL_REPLY_TO=                # optional, e.g. info@ggafrikaneleganz.com
SMTP_HOST=                    # from the provider, e.g. smtp.postmarkapp.com / email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=                # from the provider (secret)
SMTP_PASSWORD=                # from the provider (secret)
SMTP_SECURITY=starttls        # starttls (587) | ssl (465); unencrypted is not allowed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=      # e.g. us21
MAILCHIMP_LIST_ID=
APPLE_PAY_DOMAIN_ASSOCIATION= # absolute path to Stripe/Apple verification file

# Staff Studio (private staff workflow; never link the path publicly)
STUDIO_PATH=                  # production: random URL-safe path segment, at least 24 characters
STUDIO_APPROVAL_BACKEND=console # console locally; owner selected ntfy for production
STUDIO_APPROVAL_WEBHOOK_URL=  # secret HTTPS endpoint when backend=webhook
STUDIO_NTFY_SERVER=https://ntfy.sh # or the HTTPS URL of a self-hosted ntfy server
STUDIO_NTFY_TOPIC=            # long random private topic; treat it as a secret
STUDIO_NTFY_TOKEN=            # optional bearer token for a protected topic
IMAGE_MODERATION_BACKEND=       # local = private on-server nudity check for review photos (owner decision); unset = photo posts off
IMAGE_MODERATION_THRESHOLD=0.5  # higher = fewer removals; calibrated so no catalog fabric is flagged
MODERATION_RETENTION_DAYS=15  # owner decision: private removed-text record expires after 15 days
STUDIO_USERS_FILE=config/studio_users.json # usernames/roles only; never put passwords here
STUDIO_APPROVER_EMAIL=        # who approves held staff changes and key requests (default: ORDER_NOTIFICATION_EMAIL)
STUDIO_RP_ID=                 # optional passkey domain, e.g. ggafrikaneleganz.com (default: the site's host)

# Optional: run the test suite against real services instead of SQLite/fake Redis
TEST_DATABASE_URL=
TEST_REDIS_URL=

# One-off media import from the old WordPress site (dev machine only; read-only use)
# WORDPRESS_DB_URL=mysql://root@localhost/new_wordpress_local
# Where photos/videos live on disk (default: instance/media). Back it up with the database.
# MEDIA_ROOT=/srv/instance/media
# Set to 0 when the web server (nginx/Caddy) serves /media/ straight from MEDIA_ROOT.
# SERVE_MEDIA=1
